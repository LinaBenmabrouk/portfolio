---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Bandeau from "../components/Bandeau.astro";
import chibi from "../assets/images/chibi-enthousiaste.png";
import fleche from "../assets/icons/fleche.svg";
import flecheBas from "../assets/icons/fleche_bas.svg";
import chibiContact from "../assets/images/chibi_contact1.png";
import chibiContact2 from "../assets/images/chibi_contact2.png";

// Classes communes (réseaux et champs du formulaire)
const classeLigne = "flex flex-col gap-2 md:flex-row md:items-center md:gap-13";
const classeLabel = "font-titre text-sm font-bold text-bleu-fonce uppercase md:w-25 md:text-right md:text-h3 md:text-noir md:normal-case";
const classeLien = "group flex items-center gap-3 font-texte text-h4-mobile font-medium text-rose transition-colors hover:text-bleu-fonce md:text-h4";
const classeFleche = "size-5 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 md:size-6";
// Champ souligné : quand on clique dedans, la ligne devient bleue et plus épaisse (à la place du cadre).
// focus:pb-0.75 compense le 1 px de bordure en plus, pour que le champ ne bouge pas
const classeChamp = "w-full border-b border-noir bg-transparent pb-1 font-texte text-body-mobile text-noir transition-colors placeholder:text-rose placeholder:italic focus:border-b-2 focus:border-bleu-fonce focus:pb-0.75 focus-visible:outline-none md:text-body";
const classeLabelChamp = "font-titre text-h4 font-bold text-noir";
---

<Layout title="Contact" description="Une proposition de stage, d'alternance ou un projet ? Écrivez à Lina Ben Mabrouk.">
  <Hero
    surtitre="Discutons"
    sousTitre="Un projet en tête ?"
    texte="Un stage, une alternance ou simplement échanger sur le dev ? Envoyez-moi un message, je réponds rapidement."
  >
    <!-- "équipe?" est décalé vers la droite en desktop seulement
         (moins que "Folio" : le mot est plus large et sortirait de l'écran) -->
    On fait <span class="text-rose md:ml-12">équipe</span><span class="text-jaune">?</span>
    <!-- Chibi agrandi (le PNG a de grandes marges transparentes) : 1,2 fois en mobile, 1,5 fois en desktop, et penché de 6°. sizes : taille affichée après agrandissement -->
    <Image slot="visuel" src={chibi} alt="Chibi de Lina, l'air enthousiaste" widths={[256, 512, 1024]} sizes="(min-width: 768px) 768px, 170px" class="size-full scale-120 rotate-6 md:scale-150 object-contain" loading="eager" fetchpriority="high" />
  </Hero>

  <!-- Bande qui défile sous le hero (même composant que sur l'accueil) -->
  <Bandeau texte="Je recherche un stage du 29 mars au 4 juin" />

  <!-- Réseaux + personnage à gauche, formulaire à droite (l'un sous l'autre en mobile) -->
  <div class="mt-10 mb-24 flex flex-col gap-14 px-4 md:mt-20 md:flex-row md:justify-between md:gap-20 md:px-20">
    <!-- Colonne de gauche -->
    <div class="flex flex-col gap-14 md:gap-15">
      <!-- Réseaux : grille de 2 colonnes en mobile, une colonne avec un trait au milieu en desktop -->
      <div class="relative grid grid-cols-2 gap-x-3 gap-y-6 md:flex md:flex-col md:gap-13">
        <!-- Trait vertical en tirets entre les labels et les liens (desktop) : bordure gauche de 5 px en pointillés -->
        <div class="absolute top-0 bottom-0 left-31 hidden border-l-5 border-dashed border-bleu-fonce md:block"></div>

        <!-- E-mail (toute la largeur en mobile). Survol des liens : bleu foncé + la flèche glisse dans sa direction -->
        <div class:list={["col-span-2", classeLigne]}>
          <p class={classeLabel}>E-mail</p>
          <a href="mailto:linabenmabrouk23@gmail.com" class="font-texte text-h4-mobile font-medium text-rose underline-offset-4 transition-colors hover:text-bleu-fonce hover:underline md:text-h4">linabenmabrouk23@gmail.com</a>
        </div>

        <!-- Behance -->
        <div class={classeLigne}>
          <p class={classeLabel}>Behance</p>
          <a href="https://www.behance.net/linabenmabrouk" target="_blank" rel="noopener" class={classeLien}>
            Mes designs <span class="sr-only">(nouvel onglet)</span> <Image src={fleche} alt="" aria-hidden="true" class={classeFleche} />
          </a>
        </div>

        <!-- LinkedIn -->
        <div class={classeLigne}>
          <p class={classeLabel}>LinkedIn</p>
          <a href="https://www.linkedin.com/in/lina-ben-mabrouk-b28564397/" target="_blank" rel="noopener" class={classeLien}>
            Mon profil <span class="sr-only">(nouvel onglet)</span> <Image src={fleche} alt="" aria-hidden="true" class={classeFleche} />
          </a>
        </div>

        <!-- GitHub -->
        <div class={classeLigne}>
          <p class={classeLabel}>GitHub</p>
          <a href="https://github.com/LinaBenmabrouk" target="_blank" rel="noopener" class={classeLien}>
            Mes dépôts <span class="sr-only">(nouvel onglet)</span> <Image src={fleche} alt="" aria-hidden="true" class={classeFleche} />
          </a>
        </div>

        <!-- CV : la flèche est tournée vers le bas -->
        <div class={classeLigne}>
          <p class={classeLabel}>CV</p>
          <a href="/cv.pdf" download class={classeLien}>
            Télécharger <Image src={fleche} alt="" aria-hidden="true" class="size-5 rotate-135 transition-transform group-hover:translate-y-1 md:size-6" />
          </a>
        </div>
      </div>

      <!-- Personnage + bulle (à partir de xl, translate-x-12 les décale à droite sans pousser le formulaire) -->
      <div class="flex items-start justify-center gap-4 md:justify-start md:gap-3 xl:translate-x-12">
        <!-- Chibi affiché au départ, penché (width : image chargée en 480 px de large, pas en taille d'origine) -->
        <Image id="chibi-attente" src={chibiContact} alt="Lina en chibi qui fait le signe peace" width="480" class="h-auto w-55 shrink-0 -rotate-14 md:w-60" />
        <!-- Chibi affiché après l'envoi du message (caché au départ) -->
        <Image id="chibi-merci" src={chibiContact2} alt="Lina en chibi qui vous remercie" width="480" class="hidden h-auto w-55 shrink-0 -rotate-6 md:w-60" />
        <!-- Bulle au niveau des yeux. Mobile : largeur fixe (le chibi ne bouge pas quand le texte change)
             et -ml-6 pour mordre sur le bord transparent du chibi. Desktop : au moins 192 px,
             et le retour à la ligne écrit dans le texte est gardé (whitespace-pre-line) -->
        <p id="bulle" aria-live="polite" class="-ml-6 mt-25 w-40 shrink-0 origin-bottom-left rounded-3xl rounded-bl-none bg-rose px-4 py-3 font-texte text-sm font-normal text-blanc md:whitespace-pre-line md:mt-14 md:ml-0 md:w-auto md:min-w-48 md:px-6.5 md:py-4 md:text-body">Je vous réponds
          sous 48 h !</p>
      </div>
    </div>

    <!-- Formulaire de contact -->
    <form id="form-contact" class="fond-points-clair relative flex flex-col gap-17 rounded-2xl bg-bleu-clair p-5 md:w-1/2 md:p-7.5">
      <!-- Nom -->
      <div class="flex flex-col gap-6">
        <label for="nom" class={classeLabelChamp}>Nom & Prénom*</label>
        <input id="nom" type="text" name="nom" placeholder="votre nom" required class={classeChamp} />
      </div>

      <!-- E-mail -->
      <div class="flex flex-col gap-6">
        <label for="email" class={classeLabelChamp}>E-mail*</label>
        <input id="email" type="email" name="email" placeholder="exemple@gmail.com" required class={classeChamp} />
      </div>

      <!-- Sujet : liste déroulante avec la flèche à droite -->
      <div class="flex flex-col gap-6">
        <label for="sujet" class={classeLabelChamp}>Sujet*</label>
        <!-- invalid: : tant qu'aucun sujet n'est choisi, le texte est rose et en italique -->
        <div class="relative">
          <select id="sujet" name="sujet" required class="w-full appearance-none rounded-md bg-blanc px-4 py-2.5 font-texte text-body-mobile text-noir invalid:text-rose invalid:italic md:text-body">
            <option value="" disabled selected class="text-rose italic">choisir votre sujet...</option>
            <option>Proposition de stage</option>
            <option>Projet ou collaboration</option>
            <option>Question</option>
            <option>Autre</option>
          </select>
          <Image src={flecheBas} alt="" aria-hidden="true" class="pointer-events-none absolute top-1/2 right-3 size-6 -translate-y-1/2" />
        </div>
        <!-- Champ caché, qui apparaît quand on choisit "Autre" -->
        <input id="sujet-autre" type="text" name="sujetAutre" placeholder="précisez votre sujet..." aria-label="Précisez votre sujet" class:list={["hidden", classeChamp]} />
      </div>

      <!-- Message -->
      <div class="flex flex-col gap-6">
        <!-- Fond blanc, la zone grandit quand on écrit (voir le script) -->
        <label for="message" class={classeLabelChamp}>Message*</label>
        <textarea id="message" name="message" rows="3" placeholder="écrire votre message..." required class="w-full resize-none overflow-hidden rounded-md bg-blanc px-4 py-2.5 font-texte text-body-mobile text-noir placeholder:text-rose placeholder:italic md:text-body"></textarea>
      </div>

      <!-- Bouton + message de retour -->
      <div class="flex flex-col gap-3">
        <button type="submit" class="group relative flex w-full items-center justify-center gap-2.5 rounded-xl bg-jaune py-3 font-texte text-button font-bold text-noir hover:bg-jaune-clair disabled:opacity-50">
          Envoyer le message <Image src={fleche} alt="" aria-hidden="true" class="size-6 transition-transform group-enabled:group-hover:translate-x-1 group-enabled:group-hover:-translate-y-1" />
        </button>
        <p id="message-retour" aria-live="polite" class="font-texte text-small text-bleu-fonce"></p>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { envoyerMessage } from "../js/backend.mjs";

  const form = document.getElementById("form-contact");
  const bouton = form.querySelector("button");
  const retour = document.getElementById("message-retour");
  const selectSujet = document.getElementById("sujet");
  const sujetAutre = document.getElementById("sujet-autre");
  const zoneMessage = document.getElementById("message");
  const bulle = document.getElementById("bulle");
  const chibiAttente = document.getElementById("chibi-attente");
  const chibiMerci = document.getElementById("chibi-merci");
  const contenuBouton = bouton.innerHTML;
  const texteBulle = bulle.textContent.trim(); // "Je vous réponds" puis "sous 48 h !"

  // Animation de réussite : des étoiles jaillissent du bouton
  function lancerEtoiles() {
    // Pas d'animation si la personne a choisi de réduire les animations
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const zone = bouton.getBoundingClientRect();
    const couleurs = ["text-rose", "text-jaune", "text-bleu-fonce"];

    for (let i = 0; i < 16; i++) {
      const etoile = document.createElement("span");
      etoile.textContent = "✱";
      etoile.className = "pointer-events-none fixed z-50 animate-etincelle font-titre text-2xl font-bold " + couleurs[i % 3];

      // Départ : le centre du bouton
      etoile.style.left = zone.left + zone.width / 2 + "px";
      etoile.style.top = zone.top + zone.height / 2 + "px";

      // Direction : tout autour du bouton, à une distance un peu différente pour chaque étoile
      const angle = (i / 16) * 2 * Math.PI;
      const distance = 80 + Math.random() * 80;
      etoile.style.setProperty("--x", Math.cos(angle) * distance + "px");
      etoile.style.setProperty("--y", Math.sin(angle) * distance + "px");
      etoile.style.setProperty("--r", Math.random() * 360 + "deg");

      document.body.append(etoile);
      // L'étoile est supprimée à la fin de son animation
      etoile.addEventListener("animationend", () => etoile.remove());
    }
  }

  // Relance une animation sur un élément, même si elle a déjà eu lieu
  function relancerAnimation(element, classe) {
    element.classList.remove(classe);
    void element.offsetWidth;
    element.classList.add(classe);
  }

  // La bulle du personnage change de texte avec un petit rebond
  function faireParlerPerso(texte) {
    bulle.textContent = texte;
    relancerAnimation(bulle, "animate-rebond");
  }

  // Échange de chibi : on cache l'un, on montre l'autre avec un petit coucou
  function changerChibi(chibiACacher, chibiAMontrer) {
    chibiACacher.classList.add("hidden");
    chibiAMontrer.classList.remove("hidden");
    relancerAnimation(chibiAMontrer, "animate-coucou");
  }

  // "Autre" choisi : on affiche le champ pour écrire son sujet (et il devient obligatoire)
  selectSujet.addEventListener("change", () => {
    const autre = selectSujet.value === "Autre";
    sujetAutre.classList.toggle("hidden", !autre);
    sujetAutre.required = autre;
    if (autre) sujetAutre.focus();
  });

  // Le message grandit avec le texte : on remet la hauteur à zéro, puis à la hauteur du contenu
  zoneMessage.addEventListener("input", () => {
    zoneMessage.style.height = "auto";
    zoneMessage.style.height = zoneMessage.scrollHeight + "px";
  });

  form.addEventListener("submit", async (e) => {
    // On reste sur la page (pas de rechargement)
    e.preventDefault();

    // Valeurs des champs
    const donnees = new FormData(form);
    const message = {
      nom: donnees.get("nom"),
      email: donnees.get("email"),
      // Si "Autre", on envoie le sujet écrit par la personne
      sujet: donnees.get("sujet") === "Autre" ? "Autre : " + donnees.get("sujetAutre") : donnees.get("sujet"),
      message: donnees.get("message"),
    };

    // Pendant l'envoi, le bouton est désactivé
    bouton.disabled = true;
    retour.textContent = "Envoi en cours…";

    try {
      await envoyerMessage(message);
      form.reset();
      sujetAutre.classList.add("hidden");
      sujetAutre.required = false;
      zoneMessage.style.height = "auto";
      retour.textContent = "Votre message a bien été envoyé !";

      // Réussite : étoiles, bouton rose, et le perso répond
      lancerEtoiles();
      bouton.innerHTML = "Message envoyé ✱";
      bouton.classList.replace("bg-jaune", "bg-rose");
      bouton.classList.replace("text-noir", "text-blanc");
      // \n : retour à la ligne après "réponds"
      faireParlerPerso("Merci ! Je vous réponds\ntrès vite.");

      // On échange les chibis : celui qui remercie remplace celui du départ
      changerChibi(chibiAttente, chibiMerci);

      // Après 4 secondes, le bouton, le chibi et la bulle redeviennent normaux
      setTimeout(() => {
        bouton.innerHTML = contenuBouton;
        bouton.classList.replace("bg-rose", "bg-jaune");
        bouton.classList.replace("text-blanc", "text-noir");
        changerChibi(chibiMerci, chibiAttente);
        faireParlerPerso(texteBulle);
      }, 4000);
    } catch (erreur) {
      retour.textContent = "Oups, le message n'est pas parti. Réessayez plus tard.";
    }

    bouton.disabled = false;
  });
</script>
