---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import chibi from "../assets/images/chibi.png";
import imageEmplacement from "../assets/images/image_emplacement.png";
import GroupeTechno from "../components/GroupeTechno.astro";
import etoile from "../assets/icons/etoile.svg";
import rond from "../assets/icons/round.svg";
import { getCompetences, getSavoirEtre, getTechnologies, getParcours } from "../js/backend.mjs";

// Données de PocketBase : les 6 demandes partent en même temps (plus rapide que l'une après l'autre).
// Technologies : une liste par groupe
const [competences, savoirEtre, techDev, techDesign, techOutils, parcours] = await Promise.all([
  getCompetences(),
  getSavoirEtre(),
  getTechnologies("Développement Web"),
  getTechnologies("Design & Création"),
  getTechnologies("Outils"),
  getParcours(),
]);

// Cache d'une minute : la page n'est pas recalculée à chaque visite
Astro.response.headers.set("Cache-Control", "public, max-age=60");
---

<Layout title="À propos" description="Mon parcours, mes compétences du BUT MMI et les technologies que j'utilise en développement web, design et animation.">
  <Hero
    surtitre="À propos de moi"
    sousTitre="Découvrez mon parcours & mes compétences"
    boutonTexte="Télécharger mon CV"
    boutonLien="/cv.pdf"
    boutonTelecharger
  >
    <!-- "profil." est décalé vers la droite en desktop seulement
         (un peu moins que "Folio" pour ne pas sortir de l'écran à 1280 px) -->
    <!-- <br /> : "profil." toujours sur la 2e ligne -->
    Mon<br /><span class="text-rose md:ml-24">profil</span><span class="text-jaune">.</span>
    <Image slot="visuel" src={chibi} alt="" aria-hidden="true" widths={[256, 512, 1024]} sizes="(min-width: 768px) 512px, 140px" class="size-full object-contain" loading="eager" fetchpriority="high" />
  </Hero>

  <!-- Qui je suis : texte à gauche, photo à droite (l'un sous l'autre en mobile) -->
  <section class="grid gap-10 px-4 py-12 md:grid-cols-2 md:gap-24 md:px-11 md:py-16">
    <div>
      <h2 class="font-titre text-h1-mobile font-bold text-jaune-fonce uppercase md:text-h1">Qui je suis</h2>

      <!-- Paragraphes, espacés de 24 px -->
      <div class="mt-8 flex flex-col gap-6 font-texte text-body-mobile font-normal text-noir md:mt-12 md:text-body">
        <p>Je m'appelle Lina, une étudiante en BUT MMI passionnée par la création numérique sous toutes ses formes.</p>
        <p>Je souhaite plus tard travailler dans la programmation de jeux vidéo, un domaine qui m'attire autant pour son aspect technique que créatif.</p>
        <p>Mon intérêt pour le développement web s'inscrit naturellement dans cette démarche, concevoir des applications ou des jeux partage la même exigence de logique, d'interactivité et de soin apporté à l'expérience utilisateur.</p>
        <p>Je me passionne aussi pour l'animation 2D, les personnages virtuels et les environnements numériques inspirés du streaming.</p>
        <p>J'apprécie explorer différents outils et apprendre en autonomie afin de progresser sur des réalisations personnelles mêlant design visuel, et interaction.</p>
        <p>À travers mes études et mes travaux, je cherche progressivement à améliorer des compétences qui me permettront de participer à la conception d'expériences immersives dans le web comme dans les jeux vidéo.</p>
      </div>
    </div>

    <!-- PHOTO : image provisoire (image_emplacement.png), à remplacer par ma photo.
         En desktop : commence au 1er paragraphe (pt-24), finit avec le texte, un peu plus étroite (pl-12) -->
    <div class="md:pt-24 md:pl-12">
      <!-- En desktop, l'image est en absolute : elle remplit cette zone sans l'agrandir,
           c'est donc le texte qui décide de la hauteur -->
      <div class="md:relative md:h-full">
        <Image
          src={imageEmplacement}
          alt="" aria-hidden="true"
          class="aspect-square w-full object-cover md:absolute md:inset-0 md:aspect-auto md:size-full"
        />
      </div>
    </div>
  </section>

  <!-- Mes compétences : les 5 compétences du BUT MMI + les savoir-être -->
  <section class="flex flex-col gap-4 px-4 pb-16 md:gap-6 md:px-11 md:pb-24">
    <h2 class="font-titre text-h1-mobile font-bold text-jaune-fonce uppercase md:text-h1">Mes compétences</h2>

    <p class="font-texte text-body-mobile font-normal text-noir md:text-body">
      Les 5 compétences du BUT MMI, et les projets dans lesquels je les ai mises en pratique.
    </p>

    <!-- Cartes : l'une sous l'autre en mobile, 5 côte à côte en desktop -->
    <div class="flex flex-col gap-4 md:grid md:grid-cols-5 md:gap-4.5">
      {
        // Pour chaque compétence venue de PocketBase, on affiche une carte
        competences.map((competence) => (
          <article class="flex flex-col gap-2 rounded-3xl border-3 border-bleu bg-blanc px-5 py-4.5 md:gap-3 md:px-5.5 md:py-6">
            <!-- Numéro + nom : sur la même ligne en mobile, l'un sous l'autre en desktop -->
            <div class="flex items-center gap-2.5 md:flex-col md:items-start md:gap-3">
              <p class="font-texte text-sm font-bold text-rose md:text-base">{"0" + competence.numero}</p>
              <h3 class="font-titre text-h4 font-bold text-noir md:text-h3">{competence.nom}</h3>
            </div>
            <p class="font-texte text-small font-normal text-noir md:text-body-mobile">{competence.description}</p>
          </article>
        ))
      }
    </div>

    <!-- Savoir-être : label + pastilles jaunes -->
    <div class="mt-2 flex flex-col gap-3 md:mt-4 md:gap-4">
      <p class="font-texte text-body-mobile font-normal text-noir md:text-body">Savoir-être</p>
      <ul class="flex flex-wrap gap-2 md:gap-3">
        {
          // Pour chaque savoir-être venu de PocketBase, on affiche une pastille
          savoirEtre.map((qualite) => (
            <li class="rounded-full bg-jaune px-4 py-2 font-texte text-sm font-bold text-noir md:px-5 md:py-2.5 md:text-base">
              {qualite.nom}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Technologies & outils : 3 groupes de cartes -->
  <section class="px-4 pb-16 md:px-11 md:pb-24">
    <div class="mb-8">
      <h2 class="font-titre text-h1-mobile font-bold text-jaune-fonce uppercase md:text-h1">Technologies & outils</h2>
      <p class="mt-4 font-texte text-body-mobile font-normal text-noir md:text-h4">
        Compétences développées à travers mes projets personnels et universitaires.
      </p>
    </div>

    <div class="flex flex-col gap-10 md:gap-8">
      <GroupeTechno titre="Développement Web" technologies={techDev} />
      <GroupeTechno titre="Design & Création" technologies={techDesign} />
      <GroupeTechno titre="Outils" technologies={techOutils} />
    </div>
  </section>

  <!-- Mon parcours : frise verticale sur fond bleu clair à points -->
  <section class="fond-points relative w-full overflow-hidden bg-bleu-clair px-4 pt-10 pb-20 md:px-9 md:pt-15 md:pb-15">
    <!-- z-10 : le contenu passe devant les points (fond-points) -->
    <div class="relative z-10">
      <h2 class="mb-15 font-titre text-h1-mobile font-bold text-bleu-fonce uppercase md:mb-20 md:text-h1">Mon parcours</h2>

      <!-- Frise (pt : le trait commence un peu au-dessus de la 1re carte) -->
      <div class="relative mx-auto max-w-5xl pt-10 md:pt-8">
        <!-- Trait vertical en pointillés, du haut de la frise jusqu'au milieu de l'étoile -->
        <div class="trait-pointille absolute top-0 bottom-14 left-1/2 w-1.25 -translate-x-1/2 md:bottom-20"></div>

        <div class="flex flex-col gap-20 md:gap-12">
          {
            // Pour chaque étape du parcours : une carte, à gauche puis à droite en desktop
            parcours.map((etape, index) => (
              <!-- En desktop, chaque carte prend la moitié de la largeur (moins 48 px vers le trait) -->
              <div class:list={["md:w-1/2", index % 2 === 0 ? "md:pr-12" : "md:self-end md:pl-12"]}>
                <article class="relative rounded-3xl border-3 border-bleu bg-blanc p-5 md:p-7.5">
                  <h3 class="font-titre text-h3 font-bold text-noir">
                    {etape.titre}
                    <span class="block md:inline"> ✱ {etape.lieu}</span>
                  </h3>
                  <p class="mt-4 font-texte text-h4 font-bold text-noir">{etape.dates}</p>
                  <div class="details mt-4 font-texte text-body-mobile font-normal text-noir md:text-body" set:html={etape.details} />

                  <!-- Rond rose sur le trait : en bas de la carte en mobile, à mi-hauteur sur le trait en desktop -->
                  <Image
                    src={rond}
                    alt="" aria-hidden="true"
                    class:list={[
                      "absolute -bottom-3.5 left-1/2 size-7 -translate-x-1/2 md:top-1/2 md:bottom-auto md:translate-x-0 md:-translate-y-1/2",
                      index % 2 === 0 ? "md:left-auto md:-right-16" : "md:-left-16",
                    ]}
                  />
                </article>
              </div>
            ))
          }
        </div>

        <!-- Étoile au bout de la frise (z-10 : devant le trait) -->
        <Image src={etoile} alt="" aria-hidden="true" class="relative z-10 mx-auto mt-20 block size-28 md:mt-6 md:size-40" />
      </div>
    </div>
  </section>
</Layout>
