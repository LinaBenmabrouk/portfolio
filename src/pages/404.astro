---
// Page affichée quand l'adresse n'existe pas
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable" description="Cette page n'existe pas.">
  <section class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-24 text-center md:py-32">
    <p class="font-titre text-h1 font-bold text-rose md:text-display">404</p>
    <h1 class="font-titre text-h2-mobile font-bold text-bleu-fonce md:text-h2">Oups, cette page n'existe pas</h1>
    <p class="font-texte text-body-mobile font-normal text-noir md:text-body">Elle a peut-être été déplacée, ou l'adresse contient une faute.</p>
    <a href="/" class="rounded-xl bg-jaune px-6 py-3 font-texte text-button font-normal text-noir hover:bg-jaune-clair">Retour à l'accueil</a>
  </section>
</Layout>
