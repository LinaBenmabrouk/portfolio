---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import dossierFond from "../assets/icons/dossier-fond.svg";
import dossierDevant from "../assets/icons/dossier-devant.svg";
import fleche from "../assets/icons/fleche.svg";
---
<Layout title="Page introuvable" description="Cette page n'existe pas." centre noindex>
  <section class="flex flex-1 flex-col items-center justify-center px-4 py-16 text-center md:py-24">
    <div class="relative w-52 md:w-100">
      <Image src={dossierFond} alt="" aria-hidden="true" class="w-full" />
      <Image src={dossierDevant} alt="" aria-hidden="true" class="absolute bottom-0 left-0 w-full" />
      <p class="absolute inset-x-0 bottom-4 font-titre text-h1 leading-none font-bold tracking-tight text-bleu-fonce md:bottom-6 md:text-titre-long-grand">404</p>
    </div>

    <h1 class="mt-8 text-h2-mobile font-bold text-bleu-fonce md:mt-10 md:text-h2">Page introuvable.</h1>
    <p class="mt-3 text-body-mobile text-noir md:text-body">On dirait que ce dossier est vide…</p>

    <a
      href="/"
      class="group mt-8 inline-flex items-center gap-2 rounded-lg bg-jaune px-2.5 py-2 text-mini font-semibold text-noir hover:bg-jaune-clair md:gap-3 md:rounded-xl md:px-6 md:py-4 md:text-button md:font-bold"
    >
      Retour à l'accueil
      <Image src={fleche} alt="" aria-hidden="true" class="size-3 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 md:size-6" />
    </a>
  </section>
</Layout>
