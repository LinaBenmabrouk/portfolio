---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Bandeau from "../components/Bandeau.astro";
import CardCompetence from "../components/CardCompetence.astro";
import CardProjet from "../components/CardProjet.astro";
import PhotoArche from "../components/PhotoArche.astro";
import chibi from "../assets/images/chibi.png";
import fleche from "../assets/icons/fleche.svg";
import ChibiEtoile from "../assets/images/chibi_stage.png";
import { getProjetsEnAvant } from "../js/backend.mjs";

// Projets cochés "en_avant" dans PocketBase, triés par ordre
const projets = await getProjetsEnAvant();

// Cache d'une minute : la page n'est pas recalculée à chaque visite
Astro.response.headers.set("Cache-Control", "public, max-age=60");

// Fiche "Personne" pour Google (données structurées) : elle relie mon nom à ce site et à mes profils.
// Invisible sur la page, elle est lue par les moteurs de recherche
const fichePersonne = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lina Ben Mabrouk",
  jobTitle: "Développeuse front-end",
  description: "Étudiante en BUT MMI : intégration web, développement front-end, design et animation 2D.",
  url: Astro.url.origin,
  sameAs: [
    "https://www.linkedin.com/in/lina-ben-mabrouk-b28564397/",
    "https://github.com/LinaBenmabrouk",
    "https://www.behance.net/linabenmabrouk",
  ],
};
---

<Layout title="Lina Ben Mabrouk – Portfolio développeuse front-end" description="Portfolio de Lina Ben Mabrouk, étudiante en BUT MMI : intégration web, développement front-end, design et animation 2D.">
  <!-- La fiche "Personne" va dans le head (emplacement "head" du Layout) -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(fichePersonne)} />

  <Hero
    surtitre="Étudiante en BUT MMI ✱ 2e année"
    sousTitre="Salut! Je suis"
    sousTitreLigne2="Lina Ben Mabrouk"
    flecheSousTitre
    sousTitreLien="/a-propos"
    texte="Intégration web et développement d'applications front-end."
    boutonTexte="Voir mes projets"
    boutonLien="/projets"
  >
    <!-- "Folio" est décalé vers la droite, comme sur la maquette -->
    Port <span class="ml-7 text-rose md:ml-28">Folio</span><span class="text-jaune">.</span>
    <Image slot="visuel" src={chibi} alt="" aria-hidden="true" widths={[256, 512, 1024]} sizes="(min-width: 768px) 512px, 140px" class="size-full object-contain" loading="eager" fetchpriority="high" />
  </Hero>

  <!-- Bandeau qui défile sous le hero -->
  <Bandeau texte="Je recherche un stage du 29 mars au 4 juin" />

  <!-- Ce que je fais : 3 domaines (en colonne en mobile, sur une ligne en desktop) -->
  <section class="px-4 pt-12 pb-20 md:px-11 md:pt-24 md:pb-32">
    <h2 class="font-titre text-h1-mobile font-bold text-jaune-fonce uppercase md:text-h1">Ce que je fais.</h2>

    <div class="mt-6 grid gap-12 md:mt-12 md:grid-cols-3 md:gap-8">
      <CardCompetence
        couleur="border-jaune"
        titre="Développement web"
        texte="J'intègre des maquettes en sites responsives et je développe des applications web interactives."
        outils="HTML · CSS · JavaScript · Astro · Tailwind"
        fond="fill-jaune"
        contour="stroke-rose"
      />
      <CardCompetence
        couleur="border-bleu-fonce"
        titre="Design UI / UX"
        texte="Je conçois l'arborescence, les parcours utilisateur et les interfaces, de la maquette au prototype."
        outils="Figma · Arborescence · Prototypage"
        fond="fill-bleu-fonce"
        contour="stroke-jaune"
      />
      <CardCompetence
        couleur="border-rose"
        titre="Animation & personnages"
        texte="Je dessine et j'anime des personnages 2D, et je découvre la modélisation 3D."
        outils="IbisPaint X · Live2D · Blender"
        fond="fill-rose"
        contour="stroke-jaune"
      />
    </div>
  </section>

  <!-- Projets sélectionnés : carrousel en mobile, 3 colonnes en desktop -->
  <section class="px-4 pb-20 md:px-11 md:pb-32">
    <!-- Titre + lien : l'un sous l'autre en mobile, sur la même ligne en desktop -->
    <div class="mb-8 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
      <h2 class="font-titre text-titre-section-mobile font-bold text-jaune-fonce uppercase md:text-h1">Projets sélectionnés.</h2>
      <a href="/projets" class="font-texte text-body font-bold text-bleu-fonce underline">Voir tous les projets →</a>
    </div>

    <div class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 scrollbar-cache md:mx-0 md:grid md:grid-cols-3 md:gap-10 md:overflow-visible md:px-0">
      {
        // Pour chaque projet venu de PocketBase, on affiche une card
        projets.map((projet) => <CardProjet projet={projet} />)
      }
    </div>
  </section>

  <!-- Qui je suis : photo puis texte en mobile. En desktop, même grille que les projets :
       photo dans la 1re colonne, texte aligné sur la 2e card -->
  <section class="flex flex-col gap-12 px-4 pb-20 md:grid md:grid-cols-3 md:gap-10 md:px-11 md:pb-32">
    <div class="md:col-span-2 md:max-w-3xl">
      <h2 class="font-titre text-h1-mobile font-bold text-jaune-fonce uppercase md:text-h1">Qui je suis.</h2>

      <p class="mt-8 font-texte text-body-mobile font-normal text-noir md:mt-12 md:text-body">
        Je m'appelle Lina, étudiante en BUT MMI passionnée par la création numérique.<br />
        Mon intérêt pour le développement web s'inscrit dans une recherche de logique, d'interactivité et de soin apporté à l'expérience utilisateur.
      </p>
      <p class="mt-6 font-texte text-body-mobile font-normal text-noir md:text-body">
        Je me passionne aussi pour l'animation 2D, les personnages virtuels et les environnements inspirés du streaming.
      </p>

      <!-- Bouton vers la page À propos -->
      <a
        href="/a-propos"
        class="group mt-8 inline-flex items-center gap-3 rounded-xl bg-jaune px-4 py-3 font-texte text-small-mobile font-bold text-noir hover:bg-jaune-clair md:mt-10 md:gap-4 md:text-button"
      >
        En savoir plus
        <Image src={fleche} alt="" aria-hidden="true" class="size-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 md:size-6" />
      </a>
    </div>

    <!-- Ma photo dans l'arche : au-dessus du texte en mobile, à gauche en desktop.
         À partir de xl, elle va du haut du titre au bas du bouton (même méthode que la page À propos) -->
    <div class="order-first xl:relative">
      <PhotoArche class="mx-auto w-full max-w-xs md:mx-0 xl:absolute xl:bottom-0 xl:left-8 xl:h-27/25 xl:w-auto xl:max-w-none" />
    </div>
  </section>

  <!-- En ce moment : encadré bleu, je cherche un stage ou une alternance -->
  <section class="px-4 pb-16 md:px-7 md:pb-24">
    <div class="flex items-center justify-between gap-8 rounded-3xl bg-bleu-fonce px-6 py-10 md:rounded-4xl md:px-17 md:py-17">
      <div class="md:max-w-4xl">
        <!-- Petit surtitre -->
        <p class="font-texte text-small-mobile font-normal tracking-widest text-jaune uppercase md:text-small">✱ En ce moment</p>

        <h2 class="mt-4 font-titre text-h2-mobile leading-7 font-bold text-blanc md:mt-6 md:text-h2 md:leading-10">Je cherche un stage ou une alternance</h2>

        <p class="mt-5 font-texte text-body-mobile font-normal text-blanc md:mt-8 md:text-body">
          En développement web front-end, et idéalement dans un studio de jeux vidéo. Je continue aussi à me former en autonomie sur de nouveaux outils.
        </p>

        <!-- Dates du stage, dans une pastille jaune -->
        <p class="mt-6 inline-block rounded-full bg-jaune px-4 py-2 font-texte text-small-mobile text-bleu-fonce md:mt-10 md:px-6 md:py-3 md:text-button">
          ✱ Stage : <span class="ml-1 font-bold md:text-small">du 29 mars au 4 juin 2027</span>
        </p>

        <!-- Bouton : télécharge le CV (fichier public/cv.pdf) -->
        <div class="mt-5 md:mt-8">
          <a
            href="/cv.pdf"
            download
            class="group inline-flex items-center gap-3 rounded-xl bg-jaune px-4 py-3 font-texte text-small-mobile font-bold text-noir hover:bg-jaune-clair focus-visible:outline-jaune md:gap-4 md:text-button"
          >
            Télécharger mon CV
            <!-- Flèche tournée vers le bas, comme dans la page contact -->
            <Image src={fleche} alt="" aria-hidden="true" class="size-4 rotate-135 transition-transform group-hover:translate-y-1 md:size-6" />
          </a>
        </div>
      </div>

      <!-- Mon personnage étoile (caché en mobile pour laisser la place au texte),
           avec des ✱ qui scintillent autour (animate-scintille, chacun avec un petit retard différent) -->
      <div aria-hidden="true" class="relative hidden shrink-0 md:block">
        <Image src={ChibiEtoile} alt="" class="h-72 w-auto xl:h-96" />
        <span class="absolute top-4 left-0 animate-scintille text-2xl text-jaune">✱</span>
        <span class="absolute top-1/4 -right-4 animate-scintille text-xl text-rose" style="animation-delay: 0.8s">✱</span>
        <span class="absolute bottom-1/4 -left-6 animate-scintille text-lg text-rose" style="animation-delay: 1.4s">✱</span>
        <span class="absolute right-2 bottom-6 animate-scintille text-2xl text-jaune" style="animation-delay: 0.4s">✱</span>
      </div>
    </div>
  </section>
</Layout>
