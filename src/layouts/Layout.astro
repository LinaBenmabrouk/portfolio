---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/400-italic.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/titan-one/400.css";
import "@fontsource/anton/400.css";
import "@fontsource/micro-5/400.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// centre : le main devient flex, pour qu'une page puisse remplir et centrer la hauteur libre (page 404)
const { title, description = "", centre = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Favicon : le logo étoile -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Lina Ben Mabrouk</title>
  </head>
  <!-- Au moins la hauteur de l'écran : main prend la place libre, le footer reste en bas -->
  <body class="flex min-h-dvh flex-col">
    <!-- Étoiles qui flottent dans les marges, derrière le contenu -->
    <div aria-hidden="true" class="fond-anime fixed inset-0 -z-10"></div>
    <!-- Lien d'évitement : caché, il apparaît au 1er appui sur Tab et mène directement au contenu -->
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-jaune focus:px-4 focus:py-2 focus:font-bold focus:text-noir">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class:list={["grow", centre && "flex flex-col"]}>
      <slot />
    </main>
    <Footer />

    <script>
      // Petites étoiles derrière la souris (pas sur téléphone, ni si "réduire les animations" est activé)
      const avecSouris = matchMedia("(hover: hover) and (pointer: fine)").matches;
      const moinsAnimations = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (avecSouris && !moinsAnimations) {
        const couleurs = ["bg-jaune", "bg-rose"];
        let dernierX = 0;
        let dernierY = 0;
        let numero = 0;

        document.addEventListener("mousemove", (evenement) => {
          // Une étoile tous les 70 px parcourus, pour ne pas en mettre trop
          if (Math.hypot(evenement.clientX - dernierX, evenement.clientY - dernierY) < 70) return;
          dernierX = evenement.clientX;
          dernierY = evenement.clientY;

          const etoile = document.createElement("span");
          etoile.className = "etoile-curseur " + couleurs[numero % 2];
          etoile.style.left = evenement.clientX + "px";
          etoile.style.top = evenement.clientY + "px";
          document.body.append(etoile);
          numero = numero + 1;

          // L'étoile est retirée de la page à la fin de son animation
          etoile.addEventListener("animationend", () => etoile.remove());
        });
      }
    </script>
  </body>
</html>
