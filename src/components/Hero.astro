---
import { Image } from "astro:assets";
import vagues from "../assets/icons/vagues.svg";
import exclamation from "../assets/icons/exclamation.svg";
import fleche from "../assets/icons/fleche.svg";
import flecheJaune from "../assets/icons/fleche-jaune.svg";

const {
  surtitre,
  sousTitre,
  sousTitreLigne2,
  flecheSousTitre = false,
  sousTitreLien,
  texte,
  boutonTexte,
  boutonLien,
  boutonTelecharger = false,
  boutonNouvelOnglet = false,
  sansExclamation = false,
  espaceSurtitre = false,
  titreLong = false,
} = Astro.props;

const BaliseSousTitre = sousTitreLien ? "a" : "span";

const morceaux = surtitre.split("✱");
---
<section class="relative w-full bg-bleu-fonce">
  <div aria-hidden="true" class="motif-hero absolute inset-0 z-10"></div>

  <p
    class="absolute top-1/2 left-3 z-20 -translate-x-1/2 -translate-y-1/2 -rotate-90 font-texte font-normal uppercase text-intro-mobile whitespace-nowrap text-jaune md:left-10 md:text-h4 md:tracking-large"
  >
    <span class="text-rose">✱</span> Portfolio 2026
  </p>

  <div
    class="relative z-20 flex min-h-60 items-center gap-8 py-6 pr-2 pl-10 md:h-175 md:items-start md:gap-0 md:py-0 md:pt-20 md:pr-15 md:pl-18"
  >
    <div class="shrink-0 md:w-1/2">
      <div id="zone-3d" class="relative h-28 w-28 md:mr-15 md:ml-auto md:h-124 md:w-128">
        <div class="size-full scale-125 md:scale-100">
          <slot name="visuel" />
        </div>
        {!sansExclamation && <Image src={exclamation} alt="" aria-hidden="true" class="absolute top-0 right-0 h-auto w-7 md:w-31" />}
      </div>
    </div>

    <div class="min-w-0 flex-1 md:w-1/2 md:flex-none md:pt-16">
      <p class="flex items-center gap-2 font-texte font-normal uppercase text-jaune text-mini md:ml-4 md:whitespace-nowrap md:text-small">
        <span class="h-px w-4 shrink-0 bg-jaune md:w-12"></span>
        <span>
          {morceaux[0]}
          {morceaux.length > 1 && <span class="text-rose">✱</span>}
          {morceaux[1]}
        </span>
      </p>

      {sousTitre && (
        <p class="relative z-10 mt-5 uppercase text-blanc font-titre font-normal text-small-mobile md:mt-9 md:ml-5 md:text-xl">
          <BaliseSousTitre href={sousTitreLien} class:list={[sousTitreLien && "group transition-colors hover:text-jaune focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-jaune motion-reduce:transition-none"]}>
            {sousTitre}
            {sousTitreLigne2 && <>{" "}<br class="md:hidden" />{sousTitreLigne2}</>}
            {flecheSousTitre && <Image src={flecheJaune} alt="" aria-hidden="true" class="ml-1 inline-block size-3 align-baseline transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 md:ml-2 md:size-5 motion-reduce:transition-none" />}
          </BaliseSousTitre>
        </p>
      )}

      <h1
        class:list={[
          "mt-3 font-titre font-bold uppercase text-rose first-line:text-blanc -skew-x-6 md:mt-6",
          titreLong ? "text-2xl/4 md:text-titre-long 2xl:text-titre-long-grand" : "text-display-mobile md:text-display",
          espaceSurtitre && "mt-5 md:mt-16",
        ]}
      >
        <slot />
      </h1>

      {
        texte && (
          <p class="mt-3 font-texte text-blanc font-normal text-intro-mobile max-w-56 md:mt-13 md:text-xl md:leading-10 md:max-w-lg">
            {texte}
          </p>
        )
      }

      {
        boutonTexte && boutonLien && (
          <a
            href={boutonLien}
            download={boutonTelecharger}
            target={boutonNouvelOnglet ? "_blank" : undefined}
            rel={boutonNouvelOnglet ? "noopener" : undefined}
            class:list={[
              "group mt-5 inline-flex items-center gap-2 rounded-lg bg-jaune text-noir hover:bg-jaune-clair focus-visible:outline-jaune font-texte font-semibold text-mini px-2.5 py-2 md:rounded-xl md:gap-3 md:font-bold md:text-button md:px-6 md:py-4 focus-visible:outline-2 focus-visible:outline-offset-2",
              texte ? "md:mt-8" : "md:mt-25",
            ]}
          >
            {boutonTexte}
            {boutonNouvelOnglet && <span class="sr-only">(nouvel onglet)</span>}
            <Image
              src={fleche}
              alt="" aria-hidden="true"
              class:list={["size-3 transition-transform md:size-6 motion-reduce:transition-none", boutonTelecharger ? "rotate-135 group-hover:translate-y-1" : "group-hover:translate-x-1 group-hover:-translate-y-1"]}
            />
          </a>
        )
      }
    </div>
  </div>
</section>

<Image
  src={vagues}
  alt="" aria-hidden="true"
  class="pointer-events-none -mt-px block aspect-11/1 w-full object-cover object-bottom"
/>
