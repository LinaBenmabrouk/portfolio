---
import PbImage from "./PbImage.astro";

const { couleur, numero, titre, sousTitre, technologies } = Astro.props;

const couleursParGroupe = {
  bleu: { trait: "border-bleu-fonce", titre: "text-bleu-fonce", pastille: "bg-bleu-fonce/15 text-bleu-fonce" },
  rose: { trait: "border-rose", titre: "text-rose", pastille: "bg-rose/15 text-rose" },
  jaune: { trait: "border-jaune-fonce", titre: "text-noir", pastille: "bg-jaune/15 text-noir" },
};
const couleurs = couleursParGroupe[couleur];
---
<div class:list={["border-t-3 pt-6", couleurs.trait]}>
  <p class="font-texte text-sm font-medium text-noir/60">{numero}</p>
  <h3 class:list={["font-titre text-h3 font-bold uppercase", couleurs.titre]}>{titre}</h3>
  <p class="font-texte text-base text-noir/60">{sousTitre}</p>

  <div class="mt-5">
    {
      technologies.map((techno) => (
        <div class="group flex items-center justify-between gap-3 border-b border-bleu-fonce/20 py-3.5">
          <div class="flex items-center gap-3.5">
            <PbImage record={techno} recordImage={techno.icone} alt={techno.nom} class="size-7.5 shrink-0 object-contain transition-transform duration-300 group-hover:scale-125" />
            <p class="font-texte text-body font-medium text-noir">{techno.nom}</p>
          </div>
          <p class:list={["shrink-0 rounded-full px-3 py-1 font-texte text-sm font-semibold", couleurs.pastille]}>{techno.niveau}</p>
        </div>
      ))
    }
  </div>
</div>
