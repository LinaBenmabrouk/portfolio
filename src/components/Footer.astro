---
import { Image } from "astro:assets";
import logo from "../assets/icons/logo-icon.svg";
import linkedin from "../assets/icons/linkedIn.svg";
import behance from "../assets/icons/behance.svg";
import github from "../assets/icons/github.svg";
import fleche from "../assets/icons/fleche.svg";

const classeTitre = "font-texte text-h4-mobile font-medium text-jaune/70 md:text-xl md:leading-11";
const classeLien = "font-titre text-body-mobile font-medium text-blanc hover:text-jaune focus-visible:outline-jaune md:text-xl md:leading-11";
const classeReseau = "transition-transform duration-300 hover:-translate-y-1 hover:scale-110 focus-visible:outline-jaune";
---
<footer class="relative w-full overflow-hidden border-t border-blanc/20 bg-bleu-fonce">
  <div aria-hidden="true" class="motif-footer absolute bottom-0 left-0 h-66 w-full"></div>

  <div
    class="relative z-10 flex flex-col items-start gap-9 px-10 py-8 md:flex-row md:gap-20 md:px-15 md:py-12"
  >
    <a href="/" aria-label="Accueil - Lina Ben Mabrouk" class="self-center focus-visible:outline-jaune">
      <Image src={logo} alt="" class="h-40 w-auto md:h-44" />
    </a>

    <div class="flex flex-col items-start md:order-last md:ml-auto md:items-end md:text-right">
      <p class="font-texte text-h4-mobile font-medium text-blanc md:text-h4">
        Un projet ou une opportunité ?<br />
        N'hésitez pas à me contacter !
      </p>
      <a
        href="/contact"
        class="group mt-5 flex items-center gap-2 rounded-lg bg-jaune px-2.5 py-2 font-texte text-xs font-semibold text-noir hover:bg-jaune-clair focus-visible:outline-jaune md:mt-6 md:gap-3 md:px-4 md:py-3 md:text-button md:font-bold"
      >
        Me contacter
        <Image src={fleche} alt="" aria-hidden="true" class="size-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 md:size-6" />
      </a>
    </div>

    <nav aria-label="Plan du site" class="flex flex-col gap-4 md:w-44 md:shrink-0 md:gap-0 md:text-right">
      <h2 class={classeTitre}>Le site</h2>
      <a href="/a-propos" class={classeLien}>À propos</a>
      <a href="/projets" class={classeLien}>Projets</a>
      <a href="/contact" class={classeLien}>Contact</a>
      <a href="/mentions-legales" class={classeLien}>Mentions légales</a>
    </nav>

    <div class="flex flex-col gap-6 md:gap-1">
      <h2 class={classeTitre}>Mes réseaux</h2>
      <div class="flex items-center gap-5">
        <a href="https://www.linkedin.com/in/lina-ben-mabrouk-b28564397/" target="_blank" rel="noopener" class={classeReseau}>
          <span class="sr-only">LinkedIn (nouvel onglet)</span>
          <Image src={linkedin} alt="" aria-hidden="true" class="h-auto w-10" />
        </a>
        <a href="https://www.behance.net/linabenmabrouk" target="_blank" rel="noopener" class={classeReseau}>
          <span class="sr-only">Behance (nouvel onglet)</span>
          <Image src={behance} alt="" aria-hidden="true" class="h-auto w-10" />
        </a>
        <a href="https://github.com/LinaBenmabrouk" target="_blank" rel="noopener" class={classeReseau}>
          <span class="sr-only">GitHub (nouvel onglet)</span>
          <Image src={github} alt="" aria-hidden="true" class="h-auto w-10" />
        </a>
      </div>
    </div>

    <p class="font-texte text-small font-medium text-jaune/70 uppercase md:absolute md:right-15 md:bottom-5">© 2026 Lina Ben Mabrouk</p>
  </div>
</footer>
