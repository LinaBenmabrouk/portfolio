---
// Images utilisées dans le footer
import { Image } from "astro:assets";
import logo from "../assets/icons/logo.svg";
import motif from "../assets/icons/motif-footer.svg";
import linkedin from "../assets/icons/linkedIn.svg";
import behance from "../assets/icons/behance.svg";
import github from "../assets/icons/github.svg";
import fleche from "../assets/icons/fleche.svg";
---

<footer class="relative w-full overflow-hidden border-t border-blanc/20 bg-bleu-fonce">
  <!-- Motif de points en fond, en bas du footer, derrière le contenu -->
  <Image
    src={motif}
    alt=""
    class="pointer-events-none absolute bottom-0 left-0 h-66 w-full object-cover object-left"
  />

  <!-- Contenu : en colonne en mobile, sur une ligne en desktop -->
  <div
    class="relative z-10 flex flex-col items-start gap-9 px-10 pt-8 pb-8 md:flex-row md:gap-20 md:px-15 md:pt-12 md:pb-12"
  >
    <!-- Logo (centré verticalement en desktop, comme sur la maquette) -->
    <a href="/" class="md:self-center">
      <Image src={logo} alt="Lina Ben Mabrouk, accueil" class="h-auto w-80 md:w-60" />
    </a>

    <!-- Texte + bouton : 2e bloc en mobile, tout à droite en desktop -->
    <div class="flex flex-col items-start md:order-last md:ml-auto md:items-end md:text-right">
      <p class="font-texte text-h4-mobile font-medium text-blanc md:text-h4">
        Un projet ou une opportunité ?<br />
        N'hésitez pas à me contacter !
      </p>
      <a
        href="/contact"
        class="mt-5 flex items-center gap-2 rounded-lg bg-jaune px-2.5 py-2 font-texte text-xs font-semibold text-noir hover:bg-jaune-clair md:mt-6 md:gap-3 md:px-4 md:py-3 md:text-button md:font-bold"
      >
        Me contacter
        <Image src={fleche} alt="" class="size-4 md:size-6" />
      </a>
    </div>

    <!-- Colonne "Le site" : alignée à droite en desktop -->
    <nav aria-label="Plan du site" class="flex flex-col gap-4 md:w-41 md:gap-0 md:text-right">
      <h2 class="font-texte text-h4-mobile font-medium text-jaune/70 md:text-xl md:leading-11">
        Le site
      </h2>
      <a href="/a-propos" class="font-titre text-body-mobile font-medium text-blanc hover:text-jaune md:text-xl md:leading-11">
        À propos
      </a>
      <a href="/projets" class="font-titre text-body-mobile font-medium text-blanc hover:text-jaune md:text-xl md:leading-11">
        Projets
      </a>
      <a href="/contact" class="font-titre text-body-mobile font-medium text-blanc hover:text-jaune md:text-xl md:leading-11">
        Contact
      </a>
    </nav>

    <!-- Colonne "Mes réseaux" -->
    <div class="flex flex-col gap-6 md:gap-1">
      <h2 class="font-texte text-h4-mobile font-medium text-jaune/70 md:text-xl md:leading-11">
        Mes réseaux
      </h2>
      <div class="flex items-center gap-5">
        <a href="https://www.linkedin.com/in/lina-ben-mabrouk-b28564397/" target="_blank" aria-label="LinkedIn">
          <Image src={linkedin} alt="" class="h-auto w-10" />
        </a>
        <a href="https://www.behance.net/linabenmabrouk" target="_blank" aria-label="Behance">
          <Image src={behance} alt="" class="h-auto w-10" />
        </a>
        <a href="https://github.com/LinaBenmabrouk" target="_blank" aria-label="GitHub">
          <Image src={github} alt="" class="h-auto w-10" />
        </a>
      </div>
    </div>

    <!-- Copyright : dernier en mobile, en bas à droite en desktop -->
    <p class="font-texte text-small font-medium text-jaune/70 uppercase md:absolute md:right-15 md:bottom-5">
      © 2026 Portfolio Lina Ben Mabrouk
    </p>
  </div>
</footer>
