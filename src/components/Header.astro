---
import { Image } from "astro:assets";
import logo from "../assets/icons/logo-icon.svg";
import iconeMenu from "../assets/icons/menu.svg";
import iconeClose from "../assets/icons/close.svg";

const classeLien = "font-texte text-xl font-normal text-blanc hover:text-jaune focus-visible:outline-jaune";
const classeLienMobile = "border-b border-bleu pb-2.5 font-texte text-h4-mobile font-normal text-blanc focus-visible:outline-jaune";

const chemin = Astro.url.pathname;
const pageAPropos = chemin.startsWith("/a-propos") ? "page" : undefined;
const pageProjets = chemin.startsWith("/projets") ? "page" : undefined;
const pageContact = chemin.startsWith("/contact") ? "page" : undefined;
---
<header class="sticky top-0 z-50 w-full border-b border-blanc/20 bg-bleu-fonce">
  <div class="flex h-16 items-center justify-between pr-6 md:h-22 md:pr-15 md:pl-8">
    <a href="/" aria-label="Accueil - Lina Ben Mabrouk" class="relative z-10 ml-6 focus-visible:outline-jaune md:ml-0">
      <Image src={logo} alt="" class="h-10 w-auto md:h-18" loading="eager" />
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-16 md:flex">
      <a href="/a-propos" aria-current={pageAPropos} class={classeLien}>À propos</a>
      <a href="/projets" aria-current={pageProjets} class={classeLien}>Projets</a>
      <a
        href="/contact"
        aria-current={pageContact}
        class="rounded-full bg-jaune px-6 py-3 font-texte text-button font-bold text-noir uppercase hover:bg-jaune-clair focus-visible:outline-jaune"
      >
        Contact
      </a>
    </nav>

    <button
      id="burger"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
      class="relative mt-2 size-6 focus-visible:outline-jaune md:hidden"
    >
      <Image
        id="icone-menu"
        src={iconeMenu}
        alt="" aria-hidden="true"
        class="absolute inset-0 size-6 rotate-0 opacity-100 transition duration-300"
      />
      <Image
        id="icone-close"
        src={iconeClose}
        alt="" aria-hidden="true"
        class="absolute inset-0 size-6 rotate-90 opacity-0 transition duration-300"
      />
    </button>
  </div>

  <nav
    id="menu-mobile"
    aria-label="Navigation mobile"
    class="invisible absolute top-full left-0 mt-px w-full origin-top scale-y-0 bg-bleu-fonce px-10 py-16 transition-all duration-500 ease-rebond motion-reduce:transition-none md:hidden"
  >
    <div class="flex flex-col gap-12">
      <a href="/a-propos" aria-current={pageAPropos} class={classeLienMobile}>À propos</a>
      <a href="/projets" aria-current={pageProjets} class={classeLienMobile}>Mes projets</a>
      <a href="/contact" aria-current={pageContact} class={classeLienMobile}>Contact</a>
    </div>
  </nav>
</header>

<script>
  const burger = document.getElementById("burger");
  const menu = document.getElementById("menu-mobile");
  const iconeMenu = document.getElementById("icone-menu");
  const iconeClose = document.getElementById("icone-close");

  function ouvrirFermer() {
    const ouvert = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!ouvert));
    burger.setAttribute("aria-label", ouvert ? "Ouvrir le menu" : "Fermer le menu");

    menu.classList.toggle("invisible");
    menu.classList.toggle("scale-y-0");

    for (const icone of [iconeMenu, iconeClose]) {
      icone.classList.toggle("rotate-0");
      icone.classList.toggle("opacity-100");
      icone.classList.toggle("rotate-90");
      icone.classList.toggle("opacity-0");
    }

    if (!ouvert) setTimeout(() => menu.querySelector("a").focus(), 50);
  }

  const menuOuvert = () => burger.getAttribute("aria-expanded") === "true";

  burger.addEventListener("click", ouvrirFermer);

  document.addEventListener("keydown", (evenement) => {
    if (evenement.key === "Escape" && menuOuvert()) {
      ouvrirFermer();
      burger.focus();
    }
  });

  for (const lien of menu.querySelectorAll("a")) {
    lien.addEventListener("click", () => {
      if (menuOuvert()) ouvrirFermer();
    });
  }
</script>
