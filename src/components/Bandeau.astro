---
const { texte } = Astro.props;
---
<div class="mt-6 w-full overflow-hidden bg-jaune py-3 md:mt-9 md:py-5">
  <p class="sr-only">{texte}</p>

  <div
    aria-hidden="true"
    class="flex w-max animate-defile font-titre text-small-mobile font-bold whitespace-nowrap text-bleu-fonce motion-reduce:animate-none md:text-h4"
  >
    <div class="flex shrink-0 items-center gap-8 pr-8 md:gap-14 md:pr-14">
      <span>{texte}</span>
      <span>✱</span>
      <span>{texte}</span>
      <span>✱</span>
      <span>{texte}</span>
      <span>✱</span>
      <span>{texte}</span>
      <span>✱</span>
    </div>
    <div class="flex shrink-0 items-center gap-8 pr-8 md:gap-14 md:pr-14">
      <span>{texte}</span>
      <span>✱</span>
      <span>{texte}</span>
      <span>✱</span>
      <span>{texte}</span>
      <span>✱</span>
      <span>{texte}</span>
      <span>✱</span>
    </div>
  </div>
</div>
