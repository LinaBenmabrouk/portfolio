---
import Etoile from "./Etoile.astro";

const { couleur, titre, texte, outils, fond, contour } = Astro.props;
---
<article class:list={["flex flex-col border-t-4 pt-8", couleur]}>
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-titre text-h4 font-bold text-bleu-fonce md:text-h3">{titre}</h3>
    <Etoile fond={fond} contour={contour} class="size-8 shrink-0 md:size-12" />
  </div>

  <p class="mt-3 font-texte text-body-mobile font-normal text-noir md:mt-4 md:text-body">{texte}</p>

  <p class="mt-auto pt-3 font-texte text-small-mobile font-semibold text-rose md:pt-4 md:text-small">{outils}</p>
</article>
