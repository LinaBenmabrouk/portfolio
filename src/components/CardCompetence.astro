---
// Carte de la section "Ce que je fais"
import { Image } from "astro:assets";
import etoile from "../assets/icons/etoile.svg";

// titre, texte, et la liste des outils (texte simple, ex : "HTML · CSS")
const { titre, texte, outils } = Astro.props;
---

<!-- flex flex-col : permet de pousser les outils tout en bas de la carte -->
<article class="flex flex-col rounded-3xl border-3 border-bleu-fonce bg-blanc p-6 md:p-7">
  <!-- Étoile + titre : côte à côte en mobile, l'un sous l'autre en desktop -->
  <div class="flex items-center gap-3 md:block">
    <Image src={etoile} alt="" class="size-8 shrink-0 md:size-12" />
    <h3 class="font-titre text-h4 font-bold text-bleu-fonce md:mt-6 md:text-h3">
      {titre}
    </h3>
  </div>

  <!-- Description -->
  <p class="mt-3 font-texte text-body-mobile font-normal text-noir md:mt-4 md:text-body">
    {texte}
  </p>

  <!-- Outils utilisés : mt-auto les pousse en bas, pt garde l'espace sous le texte -->
  <p class="mt-auto pt-3 font-texte text-small-mobile font-semibold text-rose md:pt-4 md:text-small">
    {outils}
  </p>
</article>
