---
// Domaine de la section "Ce que je fais" : un trait de couleur en haut
import { Image } from "astro:assets";
import etoile from "../assets/icons/etoile-contour.svg";

// couleur : classe du trait (ex : "border-jaune"), titre, texte,
// et la liste des outils (texte simple, ex : "HTML · CSS")
const { couleur, titre, texte, outils } = Astro.props;
---

<!-- flex flex-col : permet de pousser les outils tout en bas de la colonne -->
<article class:list={["flex flex-col border-t-4 pt-8", couleur]}>
  <!-- Titre à gauche, étoile tout à droite, sur la même ligne -->
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-titre text-h4 font-bold text-bleu-fonce md:text-h3">
      {titre}
    </h3>
    <Image src={etoile} alt="" aria-hidden="true" class="size-8 shrink-0 md:size-12" />
  </div>

  <!-- Description -->
  <p class="mt-3 font-texte text-body-mobile font-normal text-noir md:mt-4 md:text-body">
    {texte}
  </p>

  <!-- Outils utilisés : mt-auto les pousse en bas, pt garde l'espace sous le texte -->
  <p class="mt-auto pt-3 font-texte text-small-mobile font-semibold text-rose md:pt-4 md:text-small">
    {outils}
  </p>
</article>
