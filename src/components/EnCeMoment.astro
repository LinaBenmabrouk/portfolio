---
import { Image } from "astro:assets";
import fleche from "../assets/icons/fleche.svg";
import chibiEtoile from "../assets/images/chibi_stage.png";

const { boutonTexte, boutonLien, boutonTelecharger = false, class: classe } = Astro.props;
---
<section class:list={["px-4 pb-16 md:px-7 md:pb-24", classe]}>
  <div class="flex items-center justify-between gap-8 rounded-3xl bg-bleu-fonce px-6 py-10 md:rounded-4xl md:px-17 md:py-17">
    <div class="md:max-w-4xl">
      <p class="font-texte text-small-mobile font-normal tracking-widest text-jaune uppercase md:text-small">✱ En ce moment</p>

      <h2 class="mt-4 font-titre text-h2-mobile leading-7 font-bold text-blanc md:mt-6 md:text-h2 md:leading-10">Je cherche un stage ou une alternance</h2>

      <p class="mt-5 font-texte text-body-mobile font-normal text-blanc md:mt-8 md:text-body">
        En développement web front-end, et idéalement dans un studio de jeux vidéo. Je continue aussi à me former en autonomie sur de nouveaux outils.
      </p>

      <p class="mt-6 inline-block rounded-full bg-jaune px-4 py-2 font-texte text-small-mobile text-bleu-fonce md:mt-10 md:px-6 md:py-3 md:text-button">
        ✱ Stage : <span class="ml-1 font-bold md:text-small">du 29 mars au 4 juin 2027</span>
      </p>

      <div class="mt-5 md:mt-8">
        <a
          href={boutonLien}
          download={boutonTelecharger}
          class="group inline-flex items-center gap-3 rounded-xl bg-jaune px-4 py-3 font-texte text-small-mobile font-bold text-noir hover:bg-jaune-clair focus-visible:outline-jaune md:gap-4 md:text-button focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {boutonTexte}
          <Image
            src={fleche}
            alt=""
            aria-hidden="true"
            class:list={["size-4 transition-transform md:size-6 motion-reduce:transition-none", boutonTelecharger ? "rotate-135 group-hover:translate-y-1" : "group-hover:translate-x-1 group-hover:-translate-y-1"]}
          />
        </a>
      </div>
    </div>

    <div aria-hidden="true" class="relative hidden shrink-0 md:block">
      <Image src={chibiEtoile} alt="" widths={[300, 600]} sizes="(min-width: 1280px) 282px, 211px" class="h-72 w-auto xl:h-96" />
      <span class="absolute top-4 left-0 animate-scintille text-2xl text-jaune motion-reduce:animate-none">✱</span>
      <span class="absolute top-1/4 -right-4 animate-scintille text-xl text-rose motion-reduce:animate-none" style="animation-delay: 0.8s">✱</span>
      <span class="absolute bottom-1/4 -left-6 animate-scintille text-lg text-rose motion-reduce:animate-none" style="animation-delay: 1.4s">✱</span>
      <span class="absolute right-2 bottom-6 animate-scintille text-2xl text-jaune motion-reduce:animate-none" style="animation-delay: 0.4s">✱</span>
    </div>
  </div>
</section>
