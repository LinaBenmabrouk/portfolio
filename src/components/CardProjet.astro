---
import PbImage from "./PbImage.astro";

const { projet } = Astro.props;

const typeProjet = projet.contexte.split(/ [·✱] /)[0];
---
<a
  href={"/projets/" + projet.slug}
  class="group flex w-80 shrink-0 snap-start flex-col overflow-hidden rounded-2xl bg-rose shadow-rose/50 transition duration-300 hover:-translate-y-2 hover:shadow-xl md:w-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bleu-fonce motion-reduce:transition-none"
>
  <div class="flex items-center gap-3 px-4 py-3 md:gap-4 md:px-6 md:py-4">
    <span class="h-px w-9 shrink-0 bg-blanc md:w-12"></span>
    <p class="font-texte text-small-mobile font-medium text-blanc md:text-body">{typeProjet}</p>
  </div>

  <div class="overflow-hidden">
    <PbImage
      record={projet}
      recordImage={projet.image_couverture}
      alt={"Couverture du projet " + projet.titre}
      widths={[400, 800]}
      sizes="(min-width: 768px) 33vw, 320px"
      class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
    />
  </div>

  <div class="flex grow flex-col gap-2 px-4 pt-4 pb-5 md:gap-3 md:px-6 md:py-6">
    <h3
      class:list={[
        "leading-8 text-jaune md:leading-9",
        projet.slug === "nunc" && "font-nunc text-3xl md:text-4xl",
        projet.slug === "flying-tap-fest" && "font-flying text-3xl uppercase md:text-4xl",
        projet.slug === "vtuber" && "font-vtuber text-5xl md:text-7xl",
        projet.slug !== "nunc" && projet.slug !== "flying-tap-fest" && projet.slug !== "vtuber" && "font-titre",
      ]}
    >
      {projet.titre}
    </h3>
    <p class="font-texte text-body-mobile font-normal text-blanc md:text-body">{projet.resume}</p>
    <p class="mt-auto pt-1 font-texte text-xs font-medium text-jaune md:text-sm md:font-bold">{projet.tags}</p>
  </div>
</a>
